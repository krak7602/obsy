{
  "name": "obsy-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check && pnpm run lint:obsidian",
    "fix": "vp check --fix",
    "lint:obsidian": "pnpm --filter @obsy/obsidian-plugin run lint:obsidian",
    "test": "vp test",
    "test:s3-local": "pnpm --filter @obsy/storage-s3 run test:local",
    "test:s3-live": "pnpm --filter @obsy/storage-s3 run test:live",
    "test:r2-live": "pnpm --filter @obsy/storage-r2 run test:live",
    "test:desktop": "pnpm --filter @obsy/obsidian-plugin run test:desktop",
    "build": "vp run --filter './packages/*' build"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
